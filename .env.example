GITHUB_TOKEN=GITHUB_TOKEN

# GitHub OAuth App — create at: github.com/settings/developers → OAuth Apps
# Callback URL (dev): http://localhost:3000/api/auth/callback/github
# Callback URL (prod): https://your-domain.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=GITHUB_CLIENT_SECRET

# Generate with: openssl rand -base64 32
AUTH_SECRET=AUTH_SECRET
